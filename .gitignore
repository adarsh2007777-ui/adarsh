# ==============================================================================
# Git Ignore Rules for Karma Mining Web Project
# ==============================================================================

# Operating System Files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Editor & IDE Configs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.code-workspace

# Node & Package Managers (if initialized later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Build Outputs & Bundles
dist/
build/
out/
.cache/
.parcel-cache/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Temporary & Log Files
*.log
*.tmp
*.bak
*.sw?
